# MediConnect Web Admin Production / Staging Configuration (.env.production.example)
#
# IMPORTANT:
# 1. On Vercel, define VITE_API_BASE_URL under Project Settings > Environment Variables.
# 2. Point VITE_API_BASE_URL to your deployed FastAPI backend URL on Render.
# 3. Trailing /api will be automatically normalized if omitted.

VITE_API_BASE_URL=https://mediconnect-backend.onrender.com/api
VITE_APP_TITLE=MediConnect Admin Console

