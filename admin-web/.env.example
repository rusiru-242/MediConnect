# MediConnect Web Admin local development configuration template.
# Copy to .env.local. Point it at the isolated local UAT backend (port 8001, database mediconnect_uat), started with
#   powershell -ExecutionPolicy Bypass -File backend/scripts/start_uat_backend.ps1
# Do not point local development at port 8000 or at a deployed backend (Phase 05, P4-B3).
VITE_API_BASE_URL=http://127.0.0.1:8001/api

# Application title
VITE_APP_TITLE=MediConnect Admin
