MONGODB_URI=
DATABASE_NAME=mediconnect
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MediConnect

GOOGLE_CLIENT_ID=
 
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# AI Doctor Recommendation Agent (Phase 18)
# If left blank, MediConnect seamlessly uses deterministic bilingual (EN/SI) NLP
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional separate image models (empty = use the text model; both defaults accept images).
GEMINI_VISION_MODEL=
OPENAI_VISION_MODEL=
# Provider order: primary is tried first, secondary only after the primary fails ("none" disables a slot).
AI_PRIMARY_PROVIDER=gemini
AI_SECONDARY_PROVIDER=openai
AI_DAILY_REQUEST_LIMIT=2000
AI_TIMEOUT_SECONDS=5
AI_VISION_TIMEOUT_SECONDS=25
AI_MAX_RECOMMENDATIONS=10
