# ==============================================================================
# MediConnect - Production Environment Template (.env.production.example)
#
# IMPORTANT PRODUCTION GUIDELINES:
# 1. Never commit real production credentials to version control.
# 2. Store production secrets in a dedicated secrets manager (e.g. AWS Secrets Manager,
#    GCP Secret Manager, HashiCorp Vault) or inject via protected CI/CD pipeline variables.
# 3. Ensure all passwords and signing keys are cryptographically generated with high entropy.
# ==============================================================================

# Application Environment
# 'production' enables strict JWT secret length checks (>= 32 bytes) and HSTS headers.
ENVIRONMENT=production
APP_NAME=MediConnect

# MongoDB Atlas Production Configuration
# Must use TLS/SSL replica set URI with least-privilege user credentials.
# Example: mongodb+srv://<app_user>:<strong_password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority&tls=true
MONGODB_URI=mongodb+srv://<PRODUCTION_DB_USER>:<STRONG_DB_PASSWORD>@<PRODUCTION_CLUSTER>.mongodb.net/?retryWrites=true&w=majority&tls=true
DATABASE_NAME=mediconnect

# JWT Authentication & Cryptographic Keys
# JWT_SECRET MUST be a cryptographically random string >= 32 characters (256-bit).
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<MINIMUM_32_CHARACTERS_SECURE_RANDOM_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Web Client CORS Configuration
# Comma-separated list of trusted web origins allowed to access the API.
# Do NOT use '*' in production if credentials / cookies are shared.
ALLOWED_ORIGINS=https://app.mediconnect.lk,https://admin.mediconnect.lk,https://mediconnect.lk
SECURE_HEADERS_ENABLED=true

# Transactional Email (SMTP / Mail Relay)
# Configure an authenticated SMTP provider (SendGrid, AWS SES, Mailgun, Postmark).
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=<PRODUCTION_SMTP_API_KEY>
SMTP_FROM_EMAIL=notifications@mediconnect.lk
SMTP_FROM_NAME="MediConnect Healthcare"

# Google Sign-In OAuth 2.0
# Web client ID created in Google Cloud Console with verified OAuth Consent Screen.
GOOGLE_CLIENT_ID=<PRODUCTION_GOOGLE_CLIENT_ID>.apps.googleusercontent.com

# Stripe Payment Gateway (Live Mode)
# In production, use live keys (sk_live_..., whsec_..., pk_live_...).
# Verify that Stripe webhook endpoint is registered for events:
# - payment_intent.succeeded
# - payment_intent.payment_failed
# - payment_intent.canceled
STRIPE_SECRET_KEY=sk_live_<PRODUCTION_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=whsec_<PRODUCTION_STRIPE_WEBHOOK_SECRET>
STRIPE_PUBLISHABLE_KEY=pk_live_<PRODUCTION_STRIPE_PUBLISHABLE_KEY>
STRIPE_CURRENCY=lkr

# Firebase Cloud Messaging (FCM) Notifications
# Provide either an absolute path to the production service account JSON file
# OR inject the JSON string directly into FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_CREDENTIALS_PATH=/etc/mediconnect/secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
REMINDER_CHECK_INTERVAL_SECONDS=60

# AI Provider Integrations (Doctor Recommendation & Symptom Guidance)
# Secure API keys with quota limits configured in respective provider consoles.
GEMINI_API_KEY=<PRODUCTION_GEMINI_API_KEY>
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=<PRODUCTION_OPENAI_API_KEY>
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=5
AI_MAX_RECOMMENDATIONS=10
