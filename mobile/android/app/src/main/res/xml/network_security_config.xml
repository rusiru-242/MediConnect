<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      MediConnect Network Security Configuration:
      - By default, cleartext (HTTP) traffic is strictly forbidden.
      - Enforces TLS 1.2+ and system trust anchors for all production hostnames (e.g. api.mediconnect.lk).
      - Allows cleartext traffic ONLY to local loopback and developer private networks for development/testing.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local development and emulator domains permitted for debug / testing -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.1.0/24</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">10.0.0.0/8</domain>
    </domain-config>
</network-security-config>
