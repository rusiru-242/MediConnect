<?xml version="1.0" encoding="utf-8"?>
<!-- R01: launch window before Android 12 (white background, centred MediConnect symbol). Android 12+ uses the
     system splash configured in values-v31/styles.xml instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_symbol" />
    </item>
</layer-list>
